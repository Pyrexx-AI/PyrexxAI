/* ---------- Final CTA ---------- */
.cta-band { text-align: center; border-radius: 20px; padding: clamp(28px, 6vw, 64px) clamp(16px, 4vw, 32px); background: var(--tint); box-shadow: inset 0 0 0 1px var(--line), var(--shadow-card); }
