.site-footer { border-top: 1px solid var(--line); background: var(--bg-alt); padding: clamp(32px, 5vw, 56px) 0 calc(24px + env(safe-area-inset-bottom, 0px)); font-size: 13.5px; color: var(--muted); }
.footer-grid { display: grid; gap: 28px; grid-template-columns: 1fr 1fr; }
