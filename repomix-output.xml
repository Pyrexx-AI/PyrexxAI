}
.form input:focus, .form select:focus, .form textarea:focus { outline: 0; box-shadow: inset 0 0 0 2px var(--brand); }
.form input:disabled, .form select:disabled { opacity: 0.55; cursor: not-allowed; }
.form textarea { min-height: 110px; resize: vertical; }
.form__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
.form-status { padding: 12px 14px; border-radius: 12px; font-size: 13.5px; background: var(--tint); }
.form-status--error { background: #ef44441a; color: #dc2626; }
.success-state { text-align: center; padding: 24px 0; }
.success-state .icon-tile { margin: 0 auto; width: 48px; height: 48px; border-radius: 50%; }
