.breadcrumbs { margin-bottom: 16px; }
.breadcrumbs ol { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; list-style: none; padding: 0; font-size: 12.5px; color: var(--muted); }
.breadcrumbs li { display: flex; align-items: center; gap: 6px; }
