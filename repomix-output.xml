<file path="app/globals.css">
@tailwind base;
@tailwind components;
@tailwind utilities;

/* ==========================================================================
   PyrexxAI design system (v4)
   White · Blue · Purple. Tokens first, then primitives, then page sections.
   Theme switching: [data-theme="dark"] (next-themes, attribute="data-theme").
   ========================================================================== */

:root {
  --bg: #ffffff;
  --bg-alt: #f7f9fd;
  --card: #ffffff;
  --ink: #0b1220;
  --muted: #5b6577;
  --line: #e7ebf3;
  --tint: #eef3ff;
  --brand: #2563eb;
  --brand-strong: #1d4ed8;
  --brand-ink: #2563eb;
  --violet: #7c3aed;
  --green: #10b981;
  --green-ink: #059669;
  --amber-ink: #b45309;
  --gradient: linear-gradient(135deg, #2563eb, #7c3aed);
  /* Purple-tinted elevation (light theme) */
  --shadow-card: 0 1px 2px #0f172a0a, 0 12px 30px -16px #7c3aed55;
  --shadow-card-hover: 0 16px 36px -16px #7c3aed80;
  --shadow-pop: 0 10px 26px -12px #7c3aed66;
  --shadow-btn: 0 1px 2px #0000001f, 0 8px 18px -8px #7c3aedaa;
  --header-h: calc(72px + env(safe-area-inset-top, 0px)); /* floating island bar: 16px offset + 64px height */
  color-scheme: light;
}

[data-theme="dark"] {
  --bg: #0b0f17;
  --bg-alt: #0e1420;
  --card: #101624;
  --ink: #f3f6fc;
  --muted: #98a4b8;
  --line: #1c2536;
  --tint: #121c33;
  --brand-ink: #7aa7ff;
  --green-ink: #34d399;
  --amber-ink: #fbbf24;
  --shadow-card: none;
  --shadow-card-hover: none;
  --shadow-pop: 0 10px 24px -12px #0009;
  color-scheme: dark;
}

/* ---------- Base ---------- */
html {
  -webkit-text-size-adjust: 100%;
  overflow-x: clip;
  scroll-behavior: smooth;
  scroll-padding-top: 96px;
}
body {
  font-family: var(--font-inter), system-ui, -apple-system, "Segoe UI", sans-serif;
  font-size: 15px;
  line-height: 1.55;
  background: var(--bg);
  color: var(--ink);
  overflow-x: clip;
  font-variant-numeric: tabular-nums;
  -webkit-font-smoothing: antialiased;
}
h1, h2, h3, h4 { letter-spacing: -0.03em; line-height: 1.15; }
h2 { font-size: clamp(21px, 3.2vw, 34px); font-weight: 700; }
a { color: inherit; text-decoration: none; }
button { cursor: pointer; touch-action: manipulation; }
:focus-visible { outline: 2px solid var(--brand); outline-offset: 3px; border-radius: 8px; }
::selection { background: #7c3aed33; }

.skip-link {
  position: fixed; left: 12px; top: -64px; z-index: 100; padding: 10px 16px; border-radius: 99px;
  background: var(--ink); color: var(--bg); font-weight: 600; transition: top 0.2s;
}
.skip-link:focus { top: calc(8px + env(safe-area-inset-top, 0px)); }

.icon { width: 18px; height: 18px; flex: none; }
.wrap { max-width: 1120px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 24px); }
.text-gradient {
  background: var(--gradient); -webkit-background-clip: text; background-clip: text; color: transparent;
}
[data-theme="dark"] .text-gradient { background-image: linear-gradient(90deg, #60a5fa, #93c5fd 45%, #a78bfa); }
.eyebrow {
  display: block; margin-bottom: 10px; font-size: 11px; font-weight: 600; line-height: 1;
  letter-spacing: 0.14em; text-transform: uppercase; color: var(--brand-ink);
}
.sr-only-live { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

/* ---------- Sections ---------- */
.section { padding: clamp(44px, 7vw, 84px) 0; }
.section--alt { background: var(--bg-alt); }
.section--flush-top { padding-top: 0; }
.section-head { max-width: 600px; margin-bottom: clamp(22px, 4vw, 40px); }
.section-head--center { text-align: center; margin-inline: auto; }
.section-head p { margin-top: 10px; color: var(--muted); font-size: clamp(13.5px, 1.6vw, 16px); }

/* ---------- Buttons ---------- */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  height: clamp(34px, 5vw, 44px); padding: 0 clamp(12px, 2.4vw, 22px); border-radius: 99px;
  font-size: clamp(12px, 1.5vw, 14px); font-weight: 600; white-space: nowrap; transition: 0.2s;
}
.btn:disabled { opacity: 0.55; cursor: not-allowed; }
.btn--lg { height: 48px; padding: 0 26px; font-size: 14px; }
.btn--block { width: 100%; }
.btn--primary { background: var(--brand); color: #fff; box-shadow: var(--shadow-btn); }
.btn--primary:hover:not(:disabled) { background: var(--brand-strong); }
.btn--ghost { box-shadow: inset 0 0 0 1px var(--line); background: transparent; }
.btn--ghost:hover { background: var(--tint); }
.btn--inverse { background: var(--card); box-shadow: inset 0 0 0 1px var(--line); }

/* ---------- Reveal on scroll (below-the-fold only) ---------- */
[data-reveal] { opacity: 0; transform: translateY(12px); transition: opacity 0.5s, transform 0.5s; }
[data-reveal].is-in { opacity: 1; transform: none; }

/* ---------- Cards, tiles, grids ---------- */
.card {
  display: block; background: var(--card); border-radius: 16px; padding: clamp(14px, 2.4vw, 24px);
  box-shadow: inset 0 0 0 1px var(--line), var(--shadow-card); transition: box-shadow 0.25s;
}
.card:hover { box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--brand) 45%, var(--line)), var(--shadow-card-hover); }
.card h3 { margin: 12px 0 6px; font-size: clamp(14px, 1.8vw, 17px); font-weight: 600; }
.card p { font-size: clamp(12.5px, 1.4vw, 14px); color: var(--muted); }
.icon-tile {
  width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center; flex: none;
  background: var(--tint); color: var(--brand-ink); box-shadow: 0 6px 14px -8px #7c3aed66;
}
[data-theme="dark"] .icon-tile { box-shadow: none; }
.icon-tile--violet { color: var(--violet); background: color-mix(in srgb, var(--violet) 11%, var(--bg)); }
.icon-tile--green { color: var(--green-ink); background: #10b98118; }

.grid { display: grid; gap: 12px; grid-template-columns: 1fr 1fr; }
.grid--1 { grid-template-columns: 1fr; }
.grid--auto { grid-template-columns: 1fr; }
@media (min-width: 760px) {
  .grid--2 { grid-template-columns: 1fr 1fr; }
  .grid--3 { grid-template-columns: repeat(3, 1fr); }
  .grid--4 { grid-template-columns: repeat(4, 1fr); }
  .grid--bento { grid-template-columns: repeat(3, 1fr); }
}
.grid--2, .grid--3 { grid-template-columns: 1fr; }
@media (min-width: 760px) { .grid--2 { grid-template-columns: 1fr 1fr; } .grid--3 { grid-template-columns: repeat(3, 1fr); } }
.span-2 { grid-column: span 2; }

.check-list { list-style: none; padding: 0; margin: 14px 0 0; display: grid; gap: 8px; font-size: 13.5px; font-weight: 500; }
.check-list li { display: flex; gap: 9px; align-items: center; }
.check-list .icon { width: 16px; height: 16px; color: var(--green-ink); }
.step-num { font-size: 12px; font-weight: 700; letter-spacing: 0.06em; margin-right: 6px; }
.tag {
  display: inline-flex; align-items: center; gap: 6px; height: 24px; padding: 0 10px; border-radius: 99px;
  font-size: 11.5px; font-weight: 600; background: var(--tint); color: var(--brand-ink);
}
.tag--ok { background: #10b98118; color: var(--green-ink); }
.tag--warn { background: #f59e0b1c; color: var(--amber-ink); }
.tag--muted { background: var(--bg-alt); color: var(--muted); box-shadow: inset 0 0 0 1px var(--line); }
.stack { display: grid; gap: 12px; }
.split { display: grid; gap: clamp(20px, 4vw, 48px); align-items: start; }
@media (min-width: 860px) { .split { grid-template-columns: 1.1fr 0.9fr; } }
.split h2 { margin-bottom: 12px; }
.lead { margin-top: 12px; max-width: 620px; color: var(--muted); }
.big-quote { max-width: 820px; font-size: clamp(20px, 3.2vw, 32px); font-weight: 600; letter-spacing: -0.03em; line-height: 1.25; }
.pull-quote { margin-top: 14px; padding-left: 16px; border-left: 2px solid var(--violet); max-width: 760px; font-size: clamp(14px, 1.8vw, 17px); font-weight: 500; }
.callout {
  display: grid; gap: 14px; align-items: center; padding: clamp(16px, 3vw, 28px); border-radius: 16px;
  background: var(--tint); box-shadow: inset 3px 0 0 var(--violet);
}
@media (min-width: 760px) { .callout { grid-template-columns: 1fr auto; } }
.callout h3 { margin: 6px 0; font-size: clamp(15px, 2vw, 19px); font-weight: 600; }
.callout p { max-width: 680px; font-size: 13.5px; color: var(--muted); }
.callout .eyebrow { color: var(--violet); margin: 0; }

/* ---------- Header: "dynamic island" bar (markup + utilities live in components/Navbar.tsx) ---------- */
.brand { display: flex; align-items: center; gap: 9px; font-size: 18px; font-weight: 700; letter-spacing: -0.03em; }
.brand__mark { position: relative; width: 28px; height: 28px; border-radius: 8px; overflow: hidden; background: var(--gradient); display: grid; place-items: center; color: #fff; }
.icon-btn { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; box-shadow: inset 0 0 0 1px var(--line); background: transparent; }
.icon-btn:hover { background: var(--tint); }
.theme-toggle .sun { display: none; }
[data-theme="dark"] .theme-toggle .sun { display: block; }
[data-theme="dark"] .theme-toggle .moon { display: none; }
main { min-height: 60vh; }

/* ---------- Hero ---------- */
.hero { padding: calc(var(--header-h) + clamp(20px, 5vw, 52px)) 0 clamp(26px, 4vw, 48px); background: radial-gradient(60% 50% at 75% 0, var(--tint), transparent); }
.hero__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(112px, min(34%, 320px)); gap: clamp(14px, 4vw, 72px); align-items: center; }
.hero h1 { font-size: clamp(21px, 5.4vw, 56px); font-weight: 700; line-height: 1.08; letter-spacing: -0.035em; }
.hero__lead { margin: clamp(10px, 2vw, 18px) 0 clamp(14px, 2.6vw, 26px); max-width: 520px; font-size: clamp(12px, 1.7vw, 18px); color: var(--muted); }
.hero__cta { display: flex; flex-wrap: wrap; gap: 8px; }
.trust-row {
  display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: clamp(22px, 4vw, 40px); padding-top: clamp(14px, 2vw, 20px);
  border-top: 1px solid var(--line); font-size: clamp(11px, 1.3vw, 13px); font-weight: 500; color: var(--muted);
}
.trust-row span { display: flex; gap: 7px; align-items: center; }
.trust-row .icon { width: 15px; height: 15px; }

/* ---------- Phone mockup: every dimension scales with its own width (cqw) ---------- */
.phone-wrap { position: relative; justify-self: center; width: 100%; }
.phone {
  position: relative; display: block; width: 100%; aspect-ratio: 9 / 18.6; container-type: inline-size; cursor: pointer;
  -webkit-tap-highlight-color: transparent; animation: float 7s ease-in-out infinite; background: none; border: 0; padding: 0; text-align: left; color: inherit;
}
@keyframes float { 50% { translate: 0 -1.2%; } }
.phone__bezel {
  position: absolute; inset: 0; border-radius: 15cqw; padding: 2.6cqw;
  background: linear-gradient(145deg, #565b69, #15171d 32%, #08090c 62%, #30343f);
  box-shadow: 0 0 0 0.3cqw #0007, 0 4cqw 7cqw -3cqw #0b1220aa, 0 14cqw 16cqw -10cqw #7c3aed88, inset 0 0 0 0.35cqw #ffffff2a;
}
.phone__bezel::before { content: ""; position: absolute; left: -0.9cqw; top: 21%; width: 1cqw; height: 6.5%; border-radius: 0.6cqw 0 0 0.6cqw; background: #2d313b; box-shadow: 0 10cqw 0 #2d313b, 0 -6cqw 0 -0.2cqw #2d313b; }
.phone__bezel::after { content: ""; position: absolute; right: -0.9cqw; top: 29%; width: 1cqw; height: 11%; border-radius: 0 0.6cqw 0.6cqw 0; background: #2d313b; }
.phone__screen {
  position: relative; height: 100%; border-radius: 12.6cqw; overflow: hidden; background: var(--bg); color: var(--ink);
  font-size: 3.7cqw; line-height: 1.35; display: flex; flex-direction: column; padding: 13cqw 5cqw 4cqw; transition: background 0.3s;
}
.phone__screen::after { content: ""; position: absolute; inset: 0; background: linear-gradient(115deg, #ffffff22 0, #fff0 34%); pointer-events: none; z-index: 4; }
.phone__island { position: absolute; top: 2.6cqw; left: 50%; translate: -50% 0; width: 27cqw; height: 7.4cqw; border-radius: 9cqw; background: #000; z-index: 3; }
.phone__island::after { content: ""; position: absolute; right: 2.4cqw; top: 2.3cqw; width: 2.8cqw; height: 2.8cqw; border-radius: 50%; background: radial-gradient(#1d2a4d, #06080f); }
.phone__status { position: absolute; top: 3.3cqw; inset-inline: 8cqw; display: flex; justify-content: space-between; align-items: center; font-weight: 700; font-size: 3.3cqw; z-index: 2; }
.phone__status svg { width: 12cqw; height: 3.2cqw; }
.phone-pane { display: none; flex: 1; min-height: 0; flex-direction: column; gap: 2.4cqw; }
.phone-pane[data-active="true"] { display: flex; }
.call-head { display: flex; gap: 2.8cqw; align-items: center; }
.avatar { flex: none; width: 11cqw; height: 11cqw; border-radius: 50%; background: var(--gradient); display: grid; place-items: center; color: #fff; font-weight: 700; font-size: 4cqw; box-shadow: 0 0 0 1cqw var(--tint); }
.call-head b { display: block; font-size: 4.3cqw; line-height: 1.15; }
.call-head span { display: flex; gap: 1.4cqw; align-items: center; font-size: 2.9cqw; color: var(--muted); }
.live-dot { width: 1.8cqw; height: 1.8cqw; border-radius: 50%; background: var(--green); animation: pulse 1.6s infinite; }
@keyframes pulse { 50% { opacity: 0.35; } }
.waveform { display: flex; justify-content: center; align-items: center; gap: 1cqw; height: 13cqw; border-radius: 4cqw; background: var(--tint); }
.waveform i { width: 1.1cqw; border-radius: 1cqw; background: var(--gradient); animation: wave 1.1s ease-in-out infinite; }
@keyframes wave { 50% { transform: scaleY(0.3); } }
.bubble { padding: 2.4cqw 3cqw; border-radius: 4cqw; font-size: 3.3cqw; line-height: 1.35; }
.bubble small { display: block; font-size: 2.4cqw; font-weight: 700; opacity: 0.65; margin-bottom: 0.4cqw; }
.bubble--in { background: var(--bg-alt); box-shadow: inset 0 0 0 0.3cqw var(--line); border-bottom-left-radius: 1cqw; max-width: 88%; }
.bubble--out { background: var(--gradient); color: #fff; border-bottom-right-radius: 1cqw; margin-left: auto; max-width: 90%; }
.phone-pane[data-active="true"] .bubble { animation: pop 0.5s both; animation-delay: calc(var(--n, 0) * 0.55s); }
@keyframes pop { from { opacity: 0; transform: translateY(2cqw) scale(0.96); } }
.sync-card { margin-top: auto; display: flex; gap: 2.6cqw; align-items: center; padding: 2.8cqw; border-radius: 4cqw; background: #10b98118; box-shadow: inset 0 0 0 0.3cqw #10b98138; }
.sync-card svg { width: 5.5cqw; height: 5.5cqw; color: var(--green); flex: none; }
.sync-card b { display: block; font-size: 3.3cqw; line-height: 1.2; }
.sync-card span { font-size: 2.6cqw; color: var(--muted); }
.composer { margin-top: auto; display: flex; justify-content: space-between; align-items: center; height: 9cqw; border-radius: 5cqw; padding: 0 1.5cqw 0 3.4cqw; box-shadow: inset 0 0 0 0.3cqw var(--line); color: var(--muted); font-size: 3cqw; }
.composer i { width: 6cqw; height: 6cqw; border-radius: 50%; background: var(--gradient); color: #fff; display: grid; place-items: center; font-style: normal; font-size: 3.4cqw; }
.home-bar { flex: none; width: 30cqw; height: 1.1cqw; border-radius: 1cqw; background: var(--ink); opacity: 0.35; margin: 3cqw auto 0; }
.floating-chip {
  display: none; position: absolute; z-index: 5; gap: 10px; align-items: center; padding: 9px 13px; border-radius: 13px; background: var(--card);
  box-shadow: var(--shadow-pop), inset 0 0 0 1px var(--line); font-size: 12px; font-weight: 600; line-height: 1.25; animation: float 6s ease-in-out infinite var(--d, 0s);
}
.floating-chip small { display: block; font-weight: 400; font-size: 11px; color: var(--muted); }
.floating-chip .icon { color: var(--green-ink); }
.floating-chip--a { left: -84px; top: 24%; }
.floating-chip--b { right: -70px; bottom: 20%; --d: -3s; }
@media (min-width: 960px) { .floating-chip { display: flex; } }

/* ---------- Stats ---------- */
.stats { border-block: 1px solid var(--line); }
.stats__grid { display: grid; grid-template-columns: repeat(2, 1fr); }
.stat { padding: clamp(16px, 3vw, 28px) clamp(10px, 2vw, 20px); border-left: 1px solid var(--line); }
.stat:nth-child(odd) { border-left: 0; }
.stat:nth-child(n + 3) { border-top: 1px solid var(--line); }
.stat b { display: block; margin-bottom: 6px; font-size: clamp(24px, 4vw, 38px); font-weight: 700; line-height: 1; letter-spacing: -0.04em; }
.stat span { font-size: clamp(11.5px, 1.4vw, 13.5px); color: var(--muted); }
@media (min-width: 760px) {
  .stats__grid { grid-template-columns: repeat(4, 1fr); }
  .stat:nth-child(odd) { border-left: 1px solid var(--line); }
  .stat:first-child { border-left: 0; }
  .stat:nth-child(n + 3) { border-top: 0; }
}

/* ---------- ROI calculator ---------- */
.roi { display: grid; gap: clamp(20px, 4vw, 40px); padding: clamp(18px, 4vw, 40px); border-radius: 20px; background: var(--bg-alt); box-shadow: inset 0 0 0 1px var(--line), var(--shadow-card); }
@media (min-width: 860px) { .roi { grid-template-columns: 1.2fr 0.8fr; align-items: center; } }
.field { margin-bottom: 20px; }
.field__row { display: flex; justify-content: space-between; align-items: baseline; font-size: 14px; font-weight: 500; margin-bottom: 6px; }
.field__row output { font-weight: 700; color: var(--brand-ink); }
.range { -webkit-appearance: none; appearance: none; width: 100%; height: 28px; background: transparent; cursor: pointer; }
.range::-webkit-slider-runnable-track { height: 4px; border-radius: 2px; background: linear-gradient(90deg, var(--brand) var(--fill, 50%), var(--line) var(--fill, 50%)); }
.range::-webkit-slider-thumb { -webkit-appearance: none; width: 22px; height: 22px; margin-top: -9px; border-radius: 50%; background: #fff; border: 2px solid var(--brand); box-shadow: 0 2px 6px #7c3aed55; }
.range::-moz-range-track { height: 4px; border-radius: 2px; background: var(--line); }
.range::-moz-range-progress { height: 4px; border-radius: 2px; background: var(--brand); }
.range::-moz-range-thumb { width: 18px; height: 18px; border-radius: 50%; background: #fff; border: 2px solid var(--brand); }
.roi__result { border-radius: 16px; padding: clamp(20px, 3vw, 28px); text-align: center; background: var(--gradient); color: #fff; box-shadow: 0 26px 40px -22px #7c3aedcc; }
.roi__result small { display: block; opacity: 0.8; font-size: 12.5px; font-weight: 500; }
.roi__result b { display: block; margin: 4px 0; font-size: clamp(28px, 5vw, 40px); font-weight: 700; line-height: 1.1; letter-spacing: -0.04em; }
.roi__result hr { border: 0; border-top: 1px solid #ffffff33; margin: 16px 0; }
.roi__result em { display: block; margin-top: 14px; font-style: normal; font-size: 11.5px; opacity: 0.75; }
.roi__result .btn { margin-top: 16px; }

/* ---------- Tables ---------- */
.table-card { border-radius: 16px; background: var(--card); overflow: hidden; box-shadow: inset 0 0 0 1px var(--line), var(--shadow-card); }
.table-card table { width: 100%; border-collapse: collapse; text-align: left; font-size: 14px; }
