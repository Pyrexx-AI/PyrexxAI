.chat-launcher { position: fixed; right: max(16px, env(safe-area-inset-right, 0px)); bottom: calc(16px + env(safe-area-inset-bottom, 0px)); z-index: 80; width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; background: var(--gradient); color: #fff; box-shadow: var(--shadow-btn), 0 14px 28px -10px #7c3aed99; transition: transform 0.2s; }
