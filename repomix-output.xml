.contact-channel span { font-size: 13px; color: var(--muted); }

/* ---------- Booking widget ---------- */
.booking { min-height: 520px; display: flex; flex-direction: column; gap: 18px; }
.booking__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
