/* ---------- Inner page header ---------- */
.page-header { padding: calc(var(--header-h) + clamp(24px, 5vw, 56px)) 0 clamp(28px, 5vw, 52px); background: radial-gradient(60% 70% at 80% 0, var(--tint), transparent); border-bottom: 1px solid var(--line); }
