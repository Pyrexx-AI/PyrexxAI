/* ---------- FAQ ---------- */
.faq details { border-bottom: 1px solid var(--line); }
.faq summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: 16px; align-items: center; padding: 16px 2px; min-height: 56px; font-size: clamp(14px, 1.7vw, 16px); font-weight: 600; }
