.footer-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 20px; margin-top: 32px; padding-top: 20px; border-top: 1px solid var(--line); font-size: 12.5px; }

/* ---------- Cookie banner ---------- */
.cookie { position: fixed; inset: auto 0 0 0; z-index: 90; padding: 12px 12px calc(12px + env(safe-area-inset-bottom, 0px)); pointer-events: none; }
