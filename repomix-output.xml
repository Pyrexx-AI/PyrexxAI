.chat__typing { display: flex; gap: 5px; padding: 14px; width: 62px; }
.chat__typing i { width: 7px; height: 7px; border-radius: 50%; background: var(--muted); animation: bounce 1s infinite; }
.chat__typing i:nth-child(2) { animation-delay: 0.15s; } .chat__typing i:nth-child(3) { animation-delay: 0.3s; }
@keyframes bounce { 50% { transform: translateY(-4px); opacity: 0.5; } }
.chat__chips { display: flex; flex-wrap: wrap; gap: 6px; padding: 8px 12px; border-top: 1px solid var(--line); background: var(--bg-alt); }
.chat__chips button { height: 32px; padding: 0 12px; border-radius: 99px; font-size: 12px; font-weight: 600; background: var(--card); box-shadow: inset 0 0 0 1px var(--line); }
.chat__chips button:hover { color: var(--brand-ink); box-shadow: inset 0 0 0 1px var(--brand); }
.chat__form { display: flex; gap: 8px; padding: 12px; border-top: 1px solid var(--line); background: var(--card); }
.chat__form input { flex: 1; min-width: 0; height: 40px; padding: 0 14px; border: 0; border-radius: 99px; font-size: 16px; background: var(--bg-alt); color: var(--ink); box-shadow: inset 0 0 0 1px var(--line); }
.chat__form input:focus { outline: 0; box-shadow: inset 0 0 0 2px var(--brand); }
.chat__form button { width: 40px; height: 40px; flex: none; border-radius: 50%; display: grid; place-items: center; background: var(--brand); color: #fff; }
.chat__form button:disabled { background: var(--muted); opacity: 0.5; cursor: not-allowed; }

/* ---------- Motion preferences ---------- */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation: none !important; transition-duration: 0.01ms !important; scroll-behavior: auto !important; }
  [data-reveal] { opacity: 1; transform: none; }
}

@keyframes spin { to { transform: rotate(360deg); } }

.grid--3 .span-2 { grid-column: auto; }
@media (min-width: 760px) { .grid--3 .span-2 { grid-column: span 2; } }
