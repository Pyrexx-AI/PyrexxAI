<file path="lib/chat/config.ts">
/**
 * Chatbot configuration. Models are Vercel AI Gateway ids ("provider/model").
 * Everything is overridable through environment variables so models can be swapped
 * (or fallbacks reordered) without a code change.
 */
const csv = (value?: string): string[] =>
  (value ?? "")
    .split(",")
    .map((s) => s.trim())
    .filter(Boolean);

const envFallbacks = csv(process.env.AI_CHAT_FALLBACK_MODELS);

export const CHAT_CONFIG = {
  /** Primary model: very low cost per token, low time-to-first-token. */
  model: process.env.AI_CHAT_MODEL || "anthropic/claude-haiku-5.5",
  /** Tried in order by the Gateway if the primary model or all of its providers fail. */
  fallbackModels: envFallbacks.length ? envFallbacks : ["amazon/nova-2-lite"],
  /** Replies are capped at ~3 sentences by the prompt; this is a hard cost ceiling. */
  maxOutputTokens: 350,
  /** Conversation window forwarded to the model. */
  maxMessages: 10,
  maxCharsPerMessage: 800,
  requestTimeoutMs: 20_000,
  rateLimit: { windowMs: 60_000, max: 12 },
  gatewayTags: ["pyrexxai-web", "feature:site-assistant"],
  /** "disabled" forces thinking off on Anthropic models for the lowest latency. */
  anthropicThinking: process.env.AI_CHAT_ANTHROPIC_THINKING === "disabled",
} as const;

export const CHAT_FALLBACK_REPLY =
  "I'm having trouble connecting right now. Please [book a free demo](/book-demo) or use our [contact form](/contact) and our team will help right away!";
</file>

<file path="lib/chat/rate-limit.ts">
/**
 * Best-effort sliding-window limiter, per runtime instance.
 * It stops accidental loops and casual abuse. For hard guarantees across instances
 * add a Vercel Firewall rate-limit rule on POST /api/chat (see MIGRATION.md).
 */
const hits = new Map<string, number[]>();
let lastSweep = 0;

export function rateLimit(key: string, windowMs: number, max: number) {
  const now = Date.now();

  if (now - lastSweep > windowMs) {
    lastSweep = now;
    hits.forEach((stamps, k) => {
      const fresh = stamps.filter((t) => now - t < windowMs);
      if (fresh.length) hits.set(k, fresh);
      else hits.delete(k);
    });
  }

  const stamps = (hits.get(key) ?? []).filter((t) => now - t < windowMs);
  if (stamps.length >= max) {
    return { ok: false as const, retryAfter: Math.max(1, Math.ceil((windowMs - (now - stamps[0])) / 1000)) };
  }
  stamps.push(now);
  hits.set(key, stamps);
  return { ok: true as const, retryAfter: 0 };
}

export function clientKey(req: Request): string {
  const fwd = req.headers.get("x-forwarded-for")?.split(",")[0]?.trim();
  return fwd || req.headers.get("x-real-ip") || "anonymous";
}

/** Short, non-reversible id for Gateway spend attribution (no raw IPs leave the app). */
export async function anonymousId(key: string): Promise<string> {
  const data = new TextEncoder().encode(`pyrexxai:${key}`);
  const digest = await crypto.subtle.digest("SHA-256", data);
  return Array.from(new Uint8Array(digest))
    .slice(0, 8)
    .map((b) => b.toString(16).padStart(2, "0"))
    .join("");
}
</file>

<file path="lib/chat/schema.ts">
import { z } from "zod";
import type { ModelMessage } from "ai";
import { CHAT_CONFIG } from "@/lib/chat/config";

/** Accepts the legacy client shape ({ id, role: "ai" | "user", content }) as well as "assistant". */
export const chatRequestSchema = z.object({
  messages: z
    .array(
      z.object({
        role: z.enum(["user", "assistant", "ai"]),
        content: z.string().min(1).max(4000),
      })
    )
    .min(1)
    .max(60),
});

/** Normalises to a valid alternating user/assistant window that starts with a user turn. */
export function toModelMessages(input: z.infer<typeof chatRequestSchema>["messages"]): ModelMessage[] {
  const recent = input.slice(-CHAT_CONFIG.maxMessages).map((m) => ({
    role: m.role === "user" ? ("user" as const) : ("assistant" as const),
    content: m.content.trim().slice(0, CHAT_CONFIG.maxCharsPerMessage),
  }));

  const merged: { role: "user" | "assistant"; content: string }[] = [];
  for (const m of recent) {
    if (!m.content) continue;
    const last = merged[merged.length - 1];
    if (last && last.role === m.role) last.content += `\n${m.content}`;
    else merged.push({ ...m });
  }
  while (merged.length && merged[0].role !== "user") merged.shift();
  return merged;
}
</file>

